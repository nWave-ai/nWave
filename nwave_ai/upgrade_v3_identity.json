 "hook_templates": [
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} pre-task",
   "event": "PreToolUse",
   "matcher": "Agent"
  },
  {
   "command": "INPUT=$(cat); echo \"$INPUT\" | grep -q 'execution-log\\.json' && { echo \"$INPUT\" | PYTHONPATH={lib} {python} -m {{adapter}} pre-write; exit $?; }; test -f .nwave/des/deliver-session.json || exit 0; echo \"$INPUT\" | PYTHONPATH={lib} {python} -m {{adapter}} pre-write",
   "event": "PreToolUse",
   "matcher": "Write"
  },
  {
   "command": "INPUT=$(cat); echo \"$INPUT\" | grep -q 'execution-log\\.json' && { echo \"$INPUT\" | PYTHONPATH={lib} {python} -m {{adapter}} pre-edit; exit $?; }; test -f .nwave/des/deliver-session.json || exit 0; echo \"$INPUT\" | PYTHONPATH={lib} {python} -m {{adapter}} pre-edit",
   "event": "PreToolUse",
   "matcher": "Edit"
  },
  {
   "command": "# des-hook:pre-bash\nINPUT=$(cat); CMD=$(echo \"$INPUT\" | python3 -c \"import sys,json; print(json.load(sys.stdin).get('tool_input',{}).get('command',''))\"); echo \"$CMD\" | grep -q 'execution-log' || exit 0; echo \"$CMD\" | grep -qE 'des\\.cli\\.(log_phase|init_log|verify_deliver_integrity)' && exit 0; echo '{\"decision\":\"block\",\"reason\":\"Direct modification of execution-log.json via Bash is blocked.\\nTo read it, use the Read tool.\\nTo modify it, use des.cli.log_phase.\"}'; exit 2",
   "event": "PreToolUse",
   "matcher": "Bash"
  },
  {
   "command": "# des-hook:pre-commit-attribution\nPYTHONPATH={lib} {python} -m {{adapter}} pre-tool-use",
   "event": "PreToolUse",
   "matcher": "Bash"
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} post-tool-use",
   "event": "PostToolUse",
   "matcher": "Agent"
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} subagent-stop",
   "event": "SubagentStop",
   "matcher": ""
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} deliver-progress",
   "event": "SubagentStop",
   "matcher": ""
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} session-start",
   "event": "SessionStart",
   "matcher": "startup"
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} subagent-start",
   "event": "SubagentStart",
   "matcher": ""
  },
  {
   "command": "PYTHONPATH={lib} {python} -m {{adapter}} pre-tool-use",
   "event": "PreToolUse",
   "matcher": "^Bash$|^apply_patch$"
  }
 ],
