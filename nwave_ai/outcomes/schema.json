{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://nwave.ai/schemas/outcomes/registry-entry.json",
  "title": "Outcome Registry Entry",
  "description": "A single outcome registered in docs/product/outcomes/registry.yaml. Validates the canonical entry shape used by the nwave-ai outcomes register|check pipeline.",
  "type": "object",
  "required": [
    "id",
    "kind",
    "summary",
    "feature",
    "inputs",
    "output",
    "keywords",
    "artifact",
    "related"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OUT-[A-Z0-9-]+$",
      "description": "Stable identifier matching ^OUT-[A-Z0-9-]+$ (e.g. OUT-1, OUT-E3, OUT-FORMAT)."
    },
    "kind": {
      "type": "string",
      "enum": ["specification", "operation", "invariant"]
    },
    "summary": {
      "type": "string"
    },
    "feature": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shape"],
        "additionalProperties": false,
        "properties": {
          "shape": {"type": "string", "minLength": 1}
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["shape"],
      "additionalProperties": false,
      "properties": {
        "shape": {"type": "string", "minLength": 1}
      }
    },
    "keywords": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      }
    },
    "artifact": {
      "type": "string"
    },
    "related": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^OUT-[A-Z0-9-]+$"
      }
    },
    "superseded_by": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^OUT-[A-Z0-9-]+$"}
      ]
    }
  }
}
