import { spawn } from "node:child_process";
import type { ExtensionAPI, ExtensionContext } from "@earendil-works/pi-coding-agent";

// nWave guard for pi (pi.dev, @earendil-works/pi-coding-agent), kept hook set. Generated by nwave-ai
// install. Do not edit manually.
//
// Every checked tool call runs:
//   {{PYTHON_PATH_JSON}} -m nwave_ai.hooks PreToolUse --host pi
// with the Claude-shaped PreToolUse payload on stdin. The kept module chooses the handler action from
// tool_name. Template placeholders: {{PYTHON_PATH_JSON}} and {{PYTHONPATH_JSON}}.
//
// Decisions this template records:
// - write and edit are sent to the kept module once per path; bash is sent as the Bash tool.
// - Exit 0 allows. A non-zero exit or an unreadable reply blocks, so the guard fails closed.
// - When the kept module returns updatedInput for Bash (an attribution rewrite), the input is
//   mutated in place, which pi applies to the call.
// - The extension decides nothing itself: every block reason is the kept module's reason, or the
//   guard-failure reason below when the module cannot be run.

const PYTHON = {{PYTHON_PATH_JSON}};
const RUNTIME = {{PYTHONPATH_JSON}};
const ARGS = ["-m", "nwave_ai.hooks", "PreToolUse", "--host", "pi"];
const TIMEOUT_MS = 15000;

type Call = { toolName: string; input: Record<string, unknown> };
type Reply = {
  decision?: string;
  reason?: string;
  hookSpecificOutput?: {
    permissionDecision?: string;
    permissionDecisionReason?: string;
    updatedInput?: Record<string, unknown>;
  };
};

// pi tool name -> Claude Code tool name, one call per written or edited path.
function translateToolCalls(tool: string, input: Record<string, unknown>): Call[] {
  if (tool === "bash") return [{ toolName: "Bash", input }];
  if (tool === "write" || tool === "edit") {
    const toolName = tool === "write" ? "Write" : "Edit";
    const path = typeof input.path === "string" ? [input.path] : [];
    return path.map(file => ({ toolName, input: { file_path: file } }));
  }
  return [];
}

function invoke(call: Call, ctx: ExtensionContext): Promise<{ code: number; reply: Reply; stderr: string }> {
  const payload = JSON.stringify({
    hook_event_name: "PreToolUse",
    tool_name: call.toolName,
    tool_input: call.input,
    cwd: ctx.cwd,
    session_id: ctx.sessionManager.getSessionId(),
  });
  return new Promise((resolve, reject) => {
    const child = spawn(PYTHON, ARGS, {
      cwd: ctx.cwd,
      env: { ...process.env, PYTHONPATH: RUNTIME },
      stdio: ["pipe", "pipe", "pipe"],
    });
    let stdout = "";
    let stderr = "";
    const timer = setTimeout(() => child.kill(), TIMEOUT_MS);
    child.stdout.on("data", chunk => { stdout += chunk; });
    child.stderr.on("data", chunk => { stderr += chunk; });
    child.on("error", error => { clearTimeout(timer); reject(error); });
    child.on("close", code => {
      clearTimeout(timer);
      try {
        const reply: Reply = stdout.trim() ? JSON.parse(stdout) : {};
        resolve({ code: code ?? 1, reply, stderr });
      } catch (error) {
        reject(error);
      }
    });
    child.stdin.end(payload);
  });
}

export default function (pi: ExtensionAPI) {
  pi.on("tool_call", async (event, ctx) => {
    try {
      for (const call of translateToolCalls(event.toolName, event.input)) {
        const { code, reply, stderr } = await invoke(call, ctx);
        if (stderr.trim()) console.error(`[nWave guard] ${stderr.trim()}`);
        const output = reply.hookSpecificOutput;
        if (code !== 0 || reply.decision === "block" || output?.permissionDecision === "deny") {
          return {
            block: true,
            reason: reply.reason ?? output?.permissionDecisionReason
              ?? `nWave guard failed (exit ${code}). Repair the Python runtime and rerun the installer. ${stderr.trim()}`,
          };
        }
        if (call.toolName === "Bash" && output?.updatedInput) {
          Object.assign(event.input, output.updatedInput);
        }
      }
      return undefined;
    } catch (error) {
      // A thrown tool_call error blocks in pi (fail-safe); returning the refusal keeps the reason visible.
      return {
        block: true,
        reason: `nWave guard could not check this tool call: ${error}. Repair the Python runtime and rerun the installer.`,
      };
    }
  });
}
