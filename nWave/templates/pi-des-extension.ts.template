/**
 * nWave DES extension for the pi coding agent (pi.dev).
 *
 * Translates pi lifecycle events to the Claude Code JSON hook protocol and
 * invokes the Python DES adapter via subprocess. All enforcement logic lives
 * in the Python DES engine -- this extension is a protocol translator only
 * (zero adapter fork; mirrors the OpenCode shim).
 *
 * pi has no subagents, so DES enforcement rides per-tool-call events
 * (ADR-PI-001 D6 Hybrid). Commits and test runs flow through the bash tool
 * (no dedicated git/test tool), so the translator classifies bash by command:
 *   - tool_call   -> PreToolUse   (write/edit RED gate; can block)
 *   - tool_call   -> SubagentStop (bash `git commit` step-completion; can block)
 *   - tool_result -> PostToolUse  (bash test-run suite-state recording; never blocks)
 *   - session_start runs a startup self-test that confirms the DES engine is
 *     reachable and gating is live for this (activated) project.
 *
 * pi-kata-tdd-flow EXTENDS this verification shim with the *driving* layer
 * (ADR-PKT-001): a registered `kata` command self-bootstraps a DES-tracked
 * session (KD1/KD2), and the existing bash `git commit` -> subagent-stop route
 * is fed a synthesized Claude-Code-protocol transcript so the shipped (and until
 * now inert) commit gate verifies the right step WITH commit verification (KD4).
 * Both additions stay PURE relays -- the bootstrap delegates to the Python
 * pi_kata helpers; the commit-context branch reuses the single engine-verdict
 * relay below and invents no allow/block of its own (K2: zero src/des change).
 *
 * Generated by nwave-ai install. Do not edit manually.
 *
 * Template placeholders (replaced at install time):
 *   {{PYTHON_PATH}}      -- absolute path to python3
 *   {{PYTHONPATH}}       -- path to DES lib (e.g., ~/.claude/lib/python)
 *   {{KATA_PYTHONPATH}}  -- path that makes the `pi_kata` package importable
 *                           (the installed scripts dir; ADR-PKT-001 KD3)
 */
import { spawnSync } from "node:child_process";

const PYTHON_PATH = "{{PYTHON_PATH}}";
const PYTHONPATH = "{{PYTHONPATH}}";
// The `pi_kata` bootstrap/transcript helpers live under the installed scripts
// dir, not the DES lib; the kata command/commit-context spawns add it to
// PYTHONPATH so `python -c "from pi_kata...."` imports them (KD3).
const KATA_PYTHONPATH = "{{KATA_PYTHONPATH}}";
const HEALTH_LINE = "[nWave DES] enforcement active for pi";

type DesResult = { exitCode: number; stdout: string };

function invokeDESAdapter(action: string, ccJson: Record<string, unknown>): DesResult {
  // Pin the audit log dir to the project's .nwave/des/logs so the JsonlAuditLogWriter
  // does not default to the spawned process cwd (SPIKE-0 implication 3).
  const auditLogDir = `${process.cwd()}/.nwave/des/logs`;
  const proc = spawnSync(
    PYTHON_PATH,
    ["-m", "des.adapters.drivers.hooks.claude_code_hook_adapter", action],
    {
      input: JSON.stringify(ccJson),
      env: { ...process.env, PYTHONPATH, DES_AUDIT_LOG_DIR: auditLogDir },
      encoding: "utf-8",
      timeout: 5000,
    },
  );
  return { exitCode: proc.status ?? 1, stdout: (proc.stdout ?? "").toString() };
}

// Run a pi_kata Python helper without a shell (KD3). The helpers (bootstrap.py /
// transcript_context.py) are imported by `python -c`; both PYTHONPATHs are set so
// `pi_kata` AND `des` resolve. This owns no enforcement logic -- it only relays
// the helper's stdout/exit back to the caller.
function invokeKataHelper(pySource: string): DesResult {
  const proc = spawnSync(PYTHON_PATH, ["-c", pySource], {
    env: {
      ...process.env,
      PYTHONPATH: `${KATA_PYTHONPATH}${pathSep()}${PYTHONPATH}`,
    },
    encoding: "utf-8",
    timeout: 30000,
  });
  return { exitCode: proc.status ?? 1, stdout: (proc.stdout ?? "").toString() };
}

function pathSep(): string {
  return process.platform === "win32" ? ";" : ":";
}

// Embed a JS string into a python single-quoted literal safely.
function pyStr(value: string): string {
  return `'${value.replace(/\\/g, "\\\\").replace(/'/g, "\\'")}'`;
}

// Deterministic kata-session bootstrap (ADR-PKT-001 KD1/KD2): delegate to the
// reused pi_kata.bootstrap helper, which runs des-init-log and writes the
// kata-manifest + session marker. PURE delegation -- the Python helper owns the
// (idempotent, atomic) bootstrap contract; this only relays its JSON result.
function bootstrapKataSession(projectRoot: string, kataId: string): DesResult {
  const src =
    "import json,sys;" +
    "from pi_kata.bootstrap import bootstrap_kata_session;" +
    `print(json.dumps(bootstrap_kata_session(project_root=${pyStr(projectRoot)}, kata_id=${pyStr(kataId)})))`;
  return invokeKataHelper(src);
}

// Commit-boundary context assembler (ADR-PKT-001 KD4): write the synthesized
// one-line JSONL transcript carrying the four DES markers for (kataId, stepId,
// projectRoot) via the reused pi_kata.transcript_context helper, returning the
// transcript path the subagent-stop payload references. PURE assembly -- no
// allow/block decision; the engine decides once the context is supplied.
function writeCommitContextTranscript(
  transcriptPath: string,
  projectRoot: string,
  kataId: string,
  stepId: string,
): DesResult {
  const src =
    "from pi_kata.transcript_context import write_synthesized_transcript;" +
    `write_synthesized_transcript(transcript_path=${pyStr(transcriptPath)}, ` +
    `kata_id=${pyStr(kataId)}, step_id=${pyStr(stepId)}, project_root=${pyStr(projectRoot)})`;
  return invokeKataHelper(src);
}

// Read the current (kataId, stepId) the commit gate must verify from the kata
// manifest the bootstrap command wrote. Returns null when no manifest exists
// (no kata session) -- the commit then flows through without DES context, which
// the engine treats as a non-DES passthrough (allow). PURE read.
function readKataContext(
  projectRoot: string,
): { kataId: string; stepId: string } | null {
  const src =
    "import json,sys,glob,os;" +
    `base=os.path.join(${pyStr(projectRoot)},'docs','feature');` +
    "cands=glob.glob(os.path.join(base,'*','deliver','kata-manifest.json'));" +
    "sys.exit(0) if not cands else None;" +
    "m=json.load(open(sorted(cands)[0]));" +
    "print(json.dumps({'kataId':m.get('project_id',''),'stepId':m.get('step_id','')}))";
  const result = invokeKataHelper(src);
  try {
    const parsed = JSON.parse(result.stdout.trim());
    if (parsed && parsed.kataId && parsed.stepId) {
      return { kataId: parsed.kataId, stepId: parsed.stepId };
    }
  } catch {}
  return null;
}

// Relay the engine's verdict without inventing one. The two engine boundaries
// signal a block differently and the translator surfaces whichever it emits:
//   - pre-write RED gate: exit code 2 (+ JSON reason).
//   - subagent-stop step-completion gate: exit 0 + JSON {"decision":"block"}
//     (exit 2 would make Claude Code discard the stdout JSON, so the engine uses
//     a JSON decision here -- ADR-PI-001 D5, engine reused unchanged).
// This is the SOLE block decision in the translator -- it owns no enforcement logic.
function relayEngineVerdict(result: DesResult): { block: boolean; reason: string } | undefined {
  let reason = "DES enforcement blocked this action";
  let jsonBlocked = false;
  try {
    const parsed = JSON.parse(result.stdout);
    if (parsed.decision === "block") jsonBlocked = true;
    if (parsed.reason) reason = parsed.reason;
  } catch {}
  if (result.exitCode === 2 || jsonBlocked) {
    return { block: true, reason };
  }
  return undefined;
}

// Map a pi tool name to the Claude Code (action, tool_name) pair, or null.
function mapTool(name: string): { action: string; toolName: string } | null {
  if (name === "write") return { action: "pre-write", toolName: "Write" };
  if (name === "edit") return { action: "pre-write", toolName: "Edit" };
  return null;
}

// A git commit flows through the bash tool; detect it from the command text so it
// routes to the subagent-stop step-completion validation (ADR-PI-001 D6 Hybrid).
function isGitCommitCommand(command: string): boolean {
  return /\bgit\b[^\n]*\bcommit\b/.test(command);
}

export default function (pi: any) {
  // Startup self-test: ping the gate with a sentinel the engine always blocks
  // in an activated project. A block (exit 2) proves pi -> extension -> DES
  // engine is wired and enforcement is live; exit 0 means the project is not
  // nWave-activated (enforcement dormant). Fail-open on any error.
  pi.on("session_start", () => {
    try {
      const probe = invokeDESAdapter("pre-write", {
        cwd: process.cwd(),
        tool_name: "Write",
        tool_input: { file_path: `${process.cwd()}/execution-log.json`, content: "" },
      });
      if (probe.exitCode === 2) {
        process.stderr.write(`${HEALTH_LINE}\n`);
      } else {
        process.stderr.write("[nWave DES] inactive (project not nWave-activated)\n");
      }
    } catch (err) {
      process.stderr.write(`[nWave DES] session start error (fail-open): ${err}\n`);
    }
  });

  // Kata-bootstrap command (ADR-PKT-001 KD1/KD2): `/kata <kata-id>` deterministically
  // self-bootstraps a DES-tracked kata session (reused des-init-log + kata manifest +
  // session marker) so the whole self-driven RED->GREEN->COMMIT cycle is recorded and
  // gate-ready with zero manual setup. The open-ended TDD loop is then driven by the
  // crafter skill (ADR-PI-003), not by this command. PURE delegation: the Python
  // pi_kata.bootstrap helper owns the (idempotent, atomic) contract -- this handler
  // only relays its outcome to the operator.
  pi.registerCommand("kata", {
    description: "Bootstrap a DES-tracked kata session and hand off to the crafter",
    handler: async (args: string) => {
      const kataId = (args ?? "").trim().split(/\s+/)[0] ?? "";
      if (!kataId) {
        process.stdout.write("[nWave kata] usage: /kata <kata-id>\n");
        return;
      }
      try {
        const result = bootstrapKataSession(process.cwd(), kataId);
        process.stdout.write(
          `[nWave kata] ${result.stdout.trim() || "bootstrap complete"}\n`,
        );
      } catch (err) {
        // Fail-soft: a bootstrap error is reported, never thrown into pi.
        process.stdout.write(`[nWave kata] bootstrap error: ${err}\n`);
      }
    },
  });

  // Gate: block write/edit when the DES engine returns a block decision; and
  // block a `git commit` (carried by the bash tool) at the step-completion
  // boundary via the subagent-stop validation. Both relay the engine's verdict.
  pi.on("tool_call", (event: any) => {
    const name: string = event?.toolName ?? event?.name ?? event?.tool ?? "";
    const input = event?.input ?? {};
    try {
      // Within-cycle RED gate: write/edit -> pre-write.
      const mapping = mapTool(name);
      if (mapping) {
        const result = invokeDESAdapter(mapping.action, {
          cwd: process.cwd(),
          tool_name: mapping.toolName,
          tool_input: {
            file_path: input.path ?? input.file_path ?? "",
            content: input.content ?? "",
          },
        });
        return relayEngineVerdict(result);
      }
      // Step-completion gate: bash `git commit` -> subagent-stop. The shipped
      // shim passed only {cwd, tool_name, tool_input}, which matches NEITHER
      // engine protocol, so the gate always allowed (ADR-PKT-001 context). The
      // kata driving layer (KD4) supplies DES context through the engine's
      // existing Claude Code protocol: synthesize a transcript carrying the four
      // markers for the manifest's current (kataId, stepId) and pass
      // {agent_transcript_path, cwd}. The engine then runs phase-completeness +
      // GitCommitVerifier and decides. When no kata session exists we fall back
      // to the legacy payload (a non-DES passthrough = allow).
      const command: string = input.command ?? "";
      if (name === "bash" && isGitCommitCommand(command)) {
        const kata = readKataContext(process.cwd());
        if (kata) {
          const transcriptPath = `${process.cwd()}/.nwave/des/kata-transcript.jsonl`;
          writeCommitContextTranscript(
            transcriptPath,
            process.cwd(),
            kata.kataId,
            kata.stepId,
          );
          const result = invokeDESAdapter("subagent-stop", {
            agent_transcript_path: transcriptPath,
            cwd: process.cwd(),
          });
          return relayEngineVerdict(result);
        }
        const result = invokeDESAdapter("subagent-stop", {
          cwd: process.cwd(),
          tool_name: "Bash",
          tool_input: { command },
        });
        return relayEngineVerdict(result);
      }
    } catch (err) {
      // Fail-open: a translator error must never block a legitimate tool call.
      process.stderr.write(`[nWave DES] subprocess error (fail-open): ${err}\n`);
    }
    return;
  });

  // Suite-state recording: a bash test-run tool_result carries the suite exit
  // code; relay it to the post-tool-use action so the engine records red/green.
  // This is a recording action -- it never blocks (D12 / ADR-PI-001).
  pi.on("tool_result", (event: any) => {
    const name: string = event?.toolName ?? event?.name ?? event?.tool ?? "";
    if (name !== "bash") return;
    const details = event?.details ?? {};
    const command: string = details.command ?? "";
    const exitCode: number | undefined = details.exitCode;
    try {
      invokeDESAdapter("post-tool-use", {
        cwd: process.cwd(),
        tool_name: "Bash",
        tool_input: { command },
        tool_response: { exit_code: exitCode },
      });
    } catch (err) {
      // Fail-open: recording must never disrupt the agent.
      process.stderr.write(`[nWave DES] suite-state recording error (fail-open): ${err}\n`);
    }
    return;
  });
}
