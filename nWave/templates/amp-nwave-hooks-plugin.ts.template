import type { PluginAPI } from "@ampcode/plugin";

// nWave guard for Amp (ampcode.com), kept hook set. Generated by nwave-ai install. Do not edit manually.
//
// Every checked tool call runs:
//   {{PYTHON_PATH_JSON}} -m nwave_ai.hooks PreToolUse --host amp
// with the Claude-shaped PreToolUse payload on stdin. The kept module chooses the handler action from
// tool_name. Template placeholders: {{PYTHON_PATH_JSON}} and {{PYTHONPATH_JSON}}.
//
// Decisions this template records:
// - Amp's shell tool is sent as Bash; every file an edit, create or patch call modifies is sent once as
//   Write or Edit; the Task tool is sent as Agent. Amp's own helpers name the shell command and the files.
// - Exit 0 allows. A non-zero exit or an unreadable reply blocks, so the guard fails closed, as on pi.
// - A refusal is returned as reject-and-continue, so the agent reads the kept module's reason and goes on.
// - When the kept module returns updatedInput with a command for Bash (an attribution rewrite), the shell
//   call's command is replaced through a modify result.

export const description = "nWave guard: runs the nWave kept hooks before shell, file and Task tool calls.";

const PYTHON = {{PYTHON_PATH_JSON}};
const RUNTIME = {{PYTHONPATH_JSON}};
const ARGS = ["-m", "nwave_ai.hooks", "PreToolUse", "--host", "amp"];
const TIMEOUT_MS = 15000;
const CREATE_TOOLS = new Set(["create_file", "Write"]);

type Call = { toolName: string; input: Record<string, unknown>; cwd?: string };
type Reply = {
  decision?: string;
  reason?: string;
  hookSpecificOutput?: {
    permissionDecision?: string;
    permissionDecisionReason?: string;
    updatedInput?: Record<string, unknown>;
  };
};

export default function (amp: PluginAPI) {
  const root = amp.system.workspaceRoot ? amp.helpers.filePathFromURI(amp.system.workspaceRoot) : process.cwd();

  // Amp tool call -> Claude-shaped calls the kept module reads.
  function translate(tool: string, input: Record<string, unknown>): Call[] {
    const shell = amp.helpers.shellCommandFromToolCall({ toolUseID: "", tool, input });
    if (shell) return [{ toolName: "Bash", input: { command: shell.command }, cwd: shell.dir }];
    if (tool === "Task") {
      return [{ toolName: "Agent", input: { prompt: input.prompt ?? "", subagent_type: input.description ?? "" } }];
    }
    const files = amp.helpers.filesModifiedByToolCall({ toolUseID: "", tool, input }) ?? [];
    const toolName = CREATE_TOOLS.has(tool) ? "Write" : "Edit";
    return files.map(uri => ({ toolName, input: { file_path: amp.helpers.filePathFromURI(uri) } }));
  }

  async function invoke(call: Call, threadID: string): Promise<{ code: number; reply: Reply; stderr: string }> {
    const cwd = call.cwd ?? root;
    const payload = {
      hook_event_name: "PreToolUse",
      tool_name: call.toolName,
      tool_input: call.input,
      cwd,
      session_id: threadID,
    };
    const proc = Bun.spawn([PYTHON, ...ARGS], {
      cwd,
      env: { ...process.env, PYTHONPATH: RUNTIME },
      stdin: new Blob([JSON.stringify(payload)]),
      stdout: "pipe",
      stderr: "pipe",
    });
    const timer = setTimeout(() => {
      try { proc.kill(); } catch { /* Process may already have exited. */ }
    }, TIMEOUT_MS);
    try {
      const [code, stdout, stderr] = await Promise.all([
        proc.exited, new Response(proc.stdout).text(), new Response(proc.stderr).text(),
      ]);
      const reply: Reply = stdout.trim() ? JSON.parse(stdout) : {};
      return { code, reply, stderr };
    } finally {
      clearTimeout(timer);
    }
  }

  amp.on("tool.call", async (event, ctx) => {
    try {
      let command: string | undefined;
      for (const call of translate(event.tool, event.input)) {
        const { code, reply, stderr } = await invoke(call, event.thread.id);
        if (stderr.trim()) ctx.logger.log(`[nWave guard] ${stderr.trim()}`);
        const output = reply.hookSpecificOutput;
        if (code !== 0 || reply.decision === "block" || output?.permissionDecision === "deny") {
          return {
            action: "reject-and-continue",
            message: reply.reason ?? output?.permissionDecisionReason
              ?? `nWave guard failed (exit ${code}). Repair the Python runtime and rerun the installer. ${stderr.trim()}`,
          };
        }
        const updated = output?.updatedInput?.command;
        if (call.toolName === "Bash" && typeof updated === "string") command = updated;
      }
      return command === undefined ? { action: "allow" } : { action: "modify", input: { ...event.input, command } };
    } catch (error) {
      return {
        action: "reject-and-continue",
        message: `nWave guard could not check this tool call: ${error}. Repair the Python runtime and rerun the installer.`,
      };
    }
  });
}
