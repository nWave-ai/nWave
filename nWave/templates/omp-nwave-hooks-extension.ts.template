import type { ExtensionAPI, ExtensionContext } from "@oh-my-pi/pi-coding-agent";

// nWave guard for OMP, kept hook set. Generated by nwave-ai install. Do not edit manually.
//
// Every checked tool call runs:
//   {{PYTHON_PATH_JSON}} -m nwave_ai.hooks PreToolUse --host omp
// with the Claude-shaped PreToolUse payload on stdin. The kept module chooses the handler
// action from tool_name. Template placeholders: {{PYTHON_PATH_JSON}} and {{PYTHONPATH_JSON}}.
//
// Decisions this template records. Open questions are not decided here:
// - Every write and edit is sent to the kept module. The Write/Edit shell fast path is open
//   question S5-OQ7; this template does not pin it.
// - Bash is checked for block or allow; when the kept module returns updatedInput (an
//   attribution rewrite), that input replaces the call's input, so OMP carries attribution.
// - Exit 0 allows. A non-zero exit or an unreadable reply blocks, as the DES guard does.

const PYTHON = {{PYTHON_PATH_JSON}};
const RUNTIME = {{PYTHONPATH_JSON}};
const ARGS = ["-m", "nwave_ai.hooks", "PreToolUse", "--host", "omp"];

type Call = { toolName: string; input: Record<string, unknown> };
type Reply = {
  decision?: string;
  reason?: string;
  hookSpecificOutput?: {
    permissionDecision?: string;
    permissionDecisionReason?: string;
    updatedInput?: Record<string, unknown>;
  };
};

function editedPaths(input: Record<string, unknown>): string[] {
  const paths: string[] = typeof input.path === "string" ? [input.path] : [];
  if (typeof input.input === "string") {
    // Project only file headers and move targets, not the patch's inserted text.
    for (const line of input.input.split(/\r?\n/)) {
      const header = line.match(/^\[([^#\r\n]+)#[0-9A-F]{4}\]$/i);
      const patch = line.match(/^\*\*\* (?:(?:Add|Update|Delete|Edit) File|Move to): (.+)$/);
      const move = line.match(/^MV (.+)$/);
      if (header) paths.push(header[1]);
      if (patch) paths.push(patch[1]);
      if (move) paths.push(move[1].startsWith('"') ? JSON.parse(move[1]) : move[1]);
    }
  }
  if (Array.isArray(input.edits)) {
    for (const edit of input.edits) {
      if (typeof edit.rename === "string") paths.push(edit.rename);
    }
  }
  return [...new Set(paths)].filter(path => !path.includes("://"));
}

// OMP tool name -> Claude Code tool name, one call per edited path or delegated task.
function translateToolCalls(tool: string, input: Record<string, unknown>): Call[] {
  if (tool === "task") {
    const tasks = Array.isArray(input.tasks) ? input.tasks : [input];
    return tasks.map(task => ({
      toolName: "Agent",
      input: {
        prompt: [input.context, task.task].filter(Boolean).join("\n\n"),
        subagent_type: task.agent ?? "",
      },
    }));
  }
  if (tool === "bash") return [{ toolName: "Bash", input }];
  if (tool === "write" || tool === "edit" || tool === "apply_patch") {
    const toolName = tool === "write" ? "Write" : "Edit";
    return editedPaths(input).map(path => ({ toolName, input: { file_path: path } }));
  }
  return [];
}

async function invoke(call: Call, ctx: ExtensionContext): Promise<{ code: number; reply: Reply; stderr: string }> {
  const payload = {
    hook_event_name: "PreToolUse",
    tool_name: call.toolName,
    tool_input: call.input,
    cwd: ctx.cwd,
    session_id: ctx.sessionManager.getSessionId(),
    agent_type: ctx.agent.kind === "sub" ? ctx.agent.name : undefined,
  };
  const proc = Bun.spawn([PYTHON, ...ARGS], {
    cwd: ctx.cwd,
    env: { ...process.env, PYTHONPATH: RUNTIME },
    stdin: new Blob([JSON.stringify(payload)]),
    stdout: "pipe",
    stderr: "pipe",
  });
  const timer = setTimeout(() => {
    try { proc.kill(); } catch { /* Process may already have exited. */ }
  }, 15000);
  try {
    const [code, stdout, stderr] = await Promise.all([
      proc.exited, new Response(proc.stdout).text(), new Response(proc.stderr).text(),
    ]);
    const reply: Reply = stdout.trim() ? JSON.parse(stdout) : {};
    return { code, reply, stderr };
  } finally {
    clearTimeout(timer);
  }
}

export default function (pi: ExtensionAPI) {
  pi.on("tool_call", async (event, ctx) => {
    try {
      let rewritten: Record<string, unknown> | undefined;
      for (const call of translateToolCalls(event.toolName, event.input)) {
        const { code, reply, stderr } = await invoke(call, ctx);
        if (stderr.trim()) console.error(`[nWave guard] ${stderr.trim()}`);
        const output = reply.hookSpecificOutput;
        if (code !== 0 || reply.decision === "block" || output?.permissionDecision === "deny") {
          return {
            block: true,
            reason: reply.reason ?? output?.permissionDecisionReason
              ?? `nWave guard failed (exit ${code}). Repair the Python runtime and rerun the installer. ${stderr.trim()}`,
          };
        }
        if (call.toolName === "Bash" && output?.updatedInput) rewritten = output.updatedInput;
      }
      return rewritten ? { input: rewritten } : undefined;
    } catch (error) {
      // The host ignores thrown handler errors: refusal MUST be a returned value.
      return {
        block: true,
        reason: `nWave guard could not check this tool call: ${error}. Repair the Python runtime and rerun the installer.`,
      };
    }
  });
}
