/**
 * nWave guard for OpenCode, kept hook set. Generated by nwave-ai install. Do not edit manually.
 *
 * Every checked tool call runs:
 *   {{PYTHON_PATH}} -m nwave_ai.hooks PreToolUse --host opencode
 * with the Claude-shaped PreToolUse payload on stdin. The kept module chooses the handler
 * action from tool_name.
 *
 * Template placeholders (replaced at install time): {{PYTHON_PATH}} and {{PYTHONPATH}}.
 *
 * Decisions this template records. Open questions are not decided here:
 * - Checked tools are task, write and edit, as the DES guard checked them. Bash is not checked.
 * - Every write and edit is sent to the kept module. The Write/Edit shell fast path is open
 *   question S5-OQ7; this template does not pin it.
 * - Exit 2 blocks. Any other exit code allows (fail open), as the DES guard does.
 */

import type { Plugin } from "@opencode-ai/plugin";

// OpenCode tool name -> Claude Code tool name.
const TOOL_MAP: Record<string, string> = { task: "Agent", write: "Write", edit: "Edit" };

// Refusal from the kept module (exit 2). Re-thrown; every other failure fails open.
class GuardBlock extends Error {}

function translateEvent(tool: string, input: Record<string, unknown>): Record<string, unknown> | null {
  const toolName = TOOL_MAP[tool];
  if (!toolName) return null;

  const toolInput: Record<string, unknown> = {};
  if (tool === "task") {
    toolInput.prompt = input.prompt ?? "";
    toolInput.subagent_type = input.agent ?? "";
  } else {
    // write and edit: pass through all input fields
    Object.assign(toolInput, input);
  }
  return { tool_name: toolName, tool_input: toolInput };
}

async function invokeGuard(ccJson: Record<string, unknown>): Promise<{ exitCode: number; stdout: string; stderr: string }> {
  const proc = Bun.spawn(
    ["{{PYTHON_PATH}}", "-m", "nwave_ai.hooks", "PreToolUse", "--host", "opencode"],
    {
      stdin: new Blob([JSON.stringify(ccJson)]),
      stdout: "pipe",
      stderr: "pipe",
      env: { ...process.env, PYTHONPATH: "{{PYTHONPATH}}" },
    },
  );

  const timeout = setTimeout(() => {
    try { proc.kill(); } catch {}
    console.error("[nWave guard] Python guard exceeded 5s timeout");
  }, 5000);

  const exitCode = await proc.exited;
  clearTimeout(timeout);

  const stdout = await new Response(proc.stdout).text();
  const stderr = await new Response(proc.stderr).text();

  return { exitCode, stdout, stderr };
}

export default function nwaveGuard(_ctx: Plugin) {
  return {
    "tool.execute.before": async (input: { tool: string; args: Record<string, unknown> }, output: Record<string, unknown>) => {
      // Filter: skip tools this guard does not check
      const ccJson = translateEvent(input.tool, output.args ?? {});
      if (!ccJson) return;

      try {
        const result = await invokeGuard(ccJson);

        if (result.stderr) {
          console.error(`[nWave guard] ${result.stderr.trim()}`);
        }

        // Exit 0 = allow, Exit 2 = block, anything else = fail-open
        if (result.exitCode === 2) {
          let reason = "nWave guard blocked this action";
          try {
            const parsed = JSON.parse(result.stdout);
            if (parsed.reason) reason = parsed.reason;
          } catch {}
          throw new GuardBlock(reason);
        }
        // Exit 0 or any other code: allow (fail-open)
      } catch (err) {
        if (err instanceof GuardBlock) {
          throw err;
        }
        // All other errors: fail-open (allow the tool call)
        console.error(`[nWave guard] Subprocess error (fail-open): ${err}`);
      }
    },
  };
}
